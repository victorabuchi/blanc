{% layout none %}
<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ shop.name }} &mdash; {{ 'gift_cards.issued.title' | t }}</title>
  {%- if settings.favicon -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32 }}">
  {%- else -%}
    <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
  {%- endif -%}

  {{ content_for_header }}

  {%- style -%}
    {{ settings.font_heading | font_face: font_display: 'swap' }}
    {{ settings.font_body | font_face: font_display: 'swap' }}

    :root {
      --font-heading-family: {{ settings.font_heading.family }}, {{ settings.font_heading.fallback_families }};
      --font-body-family: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }};
      --color-background: {{ settings.color_background }};
      --color-text: {{ settings.color_text }};
      --color-accent: {{ settings.color_accent }};
      --color-accent-text: {{ settings.color_accent_text }};
      --color-secondary-background: {{ settings.color_secondary_background }};
      --color-secondary-text: {{ settings.color_secondary_text }};
      --color-border: {{ settings.color_border }};
      --color-error-background: #fdecec;
      --color-error-text: #c0392b;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      background: var(--color-secondary-background);
      color: var(--color-text);
      font-family: var(--font-body-family);
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: 40px 20px;
    }

    .gift-card {
      background: var(--color-background);
      border: 1px solid var(--color-border);
      max-width: 420px;
      width: 100%;
      padding: 48px 32px;
      text-align: center;
    }

    .gift-card__shop-name {
      font-family: var(--font-heading-family);
      font-size: 16px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 24px;
    }

    .gift-card__status {
      display: inline-block;
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 4px 12px;
      border-radius: 999px;
      background: var(--color-error-background);
      color: var(--color-error-text);
      margin-bottom: 24px;
    }

    .gift-card__balance {
      font-size: 40px;
      font-weight: 700;
      margin-bottom: 4px;
    }

    .gift-card__initial-value {
      font-size: 12px;
      color: var(--color-secondary-text);
      margin-bottom: 24px;
    }

    .gift-card__message {
      font-size: 13px;
      line-height: 1.7;
      color: var(--color-secondary-text);
      margin-bottom: 24px;
    }

    .gift-card__code-wrap {
      border: 1px dashed var(--color-border);
      padding: 16px;
      margin-bottom: 16px;
    }

    .gift-card__code {
      font-size: 18px;
      font-weight: 700;
      letter-spacing: 0.1em;
      word-break: break-all;
    }

    .gift-card__copy {
      background: var(--color-accent);
      color: var(--color-accent-text);
      border: none;
      border-radius: 999px;
      padding: 10px 24px;
      font-size: 13px;
      margin-bottom: 24px;
      cursor: pointer;
      font-family: inherit;
    }

    .gift-card__copy:hover {
      opacity: 0.85;
    }

    .gift-card__qr {
      display: flex;
      justify-content: center;
      margin-bottom: 24px;
    }

    .gift-card__wallet {
      display: inline-block;
      font-size: 12px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      border: 1px solid var(--color-text);
      border-radius: 999px;
      padding: 8px 20px;
      margin-bottom: 16px;
      color: var(--color-text);
    }

    .gift-card__shop-link {
      display: block;
      font-size: 12px;
      color: var(--color-accent);
      margin-top: 8px;
    }

    .gift-card__expiry {
      font-size: 11px;
      color: var(--color-secondary-text);
      margin-top: 16px;
    }

    @media print {
      body {
        background: #fff;
        padding: 0;
      }

      .gift-card {
        border: none;
      }

      .gift-card__copy {
        display: none;
      }
    }
  {%- endstyle -%}
</head>
<body>
  <div class="gift-card">
    <p class="gift-card__shop-name">{{ shop.name }}</p>

    {%- if gift_card.expired -%}
      <span class="gift-card__status">{{ 'gift_cards.issued.expired' | t }}</span>
    {%- elsif gift_card.enabled == false -%}
      <span class="gift-card__status">{{ 'gift_cards.issued.disabled' | t }}</span>
    {%- endif -%}

    <p class="gift-card__balance">{{ gift_card.balance | money }}</p>
    {%- if gift_card.balance != gift_card.initial_value -%}
      {%- assign initial_value_money = gift_card.initial_value | money -%}
      <p class="gift-card__initial-value">
        {{ 'gift_cards.issued.initial_value' | t: value: initial_value_money }}
      </p>
    {%- endif -%}

    {%- if gift_card.message != blank -%}
      <p class="gift-card__message">{{ gift_card.message }}</p>
    {%- endif -%}

    <div class="gift-card__code-wrap">
      <p class="gift-card__code" id="gift-card-code">{{ gift_card.code }}</p>
    </div>
    <button type="button" class="gift-card__copy" id="gift-card-copy" data-code="{{ gift_card.code }}">
      {{ 'gift_cards.issued.copy_code' | t }}
    </button>

    <div class="gift-card__qr">
      <canvas id="gift-card-qr" width="140" height="140"></canvas>
    </div>

    {%- if gift_card.pass_url -%}
      <a href="{{ gift_card.pass_url }}" class="gift-card__wallet">{{ 'gift_cards.issued.add_to_apple_wallet' | t }}</a>
    {%- endif -%}

    <a href="{{ shop.url }}" class="gift-card__shop-link">{{ shop.url | remove: 'https://' | remove: 'http://' }}</a>

    {%- if gift_card.expires_on -%}
      {%- assign expires_on_formatted = gift_card.expires_on | date: '%B %d, %Y' -%}
      <p class="gift-card__expiry">{{ 'gift_cards.issued.expires_on' | t: date: expires_on_formatted }}</p>
    {%- endif -%}
  </div>

  <script src="{{ 'qrcode.min.js' | asset_url }}" defer></script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var copyBtn = document.getElementById('gift-card-copy');
      if (copyBtn) {
        copyBtn.addEventListener('click', function () {
          var code = copyBtn.getAttribute('data-code');
          if (navigator.clipboard) {
            navigator.clipboard.writeText(code);
          }
          var original = copyBtn.textContent;
          copyBtn.textContent = {{ 'gift_cards.issued.copied' | t | json }};
          setTimeout(function () {
            copyBtn.textContent = original;
          }, 2000);
        });
      }

      var canvas = document.getElementById('gift-card-qr');
      var identifier = {{ gift_card.qr_identifier | json }};
      if (canvas && identifier && window.qrcode) {
        var qr = null;
        for (var typeNumber = 4; typeNumber <= 20; typeNumber++) {
          try {
            var candidate = qrcode(typeNumber, 'M');
            candidate.addData(identifier);
            candidate.make();
            qr = candidate;
            break;
          } catch (e) {
            qr = null;
          }
        }
        if (qr) {
          var count = qr.getModuleCount();
          var ctx = canvas.getContext('2d');
          var size = canvas.width;
          var cell = size / count;
          ctx.fillStyle = '#ffffff';
          ctx.fillRect(0, 0, size, size);
          ctx.fillStyle = '#000000';
          for (var row = 0; row < count; row++) {
            for (var col = 0; col < count; col++) {
              if (qr.isDark(row, col)) {
                ctx.fillRect(col * cell, row * cell, cell, cell);
              }
            }
          }
        }
      }
    });
  </script>
</body>
</html>
