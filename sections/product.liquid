<div class="product">
  <div class="product__image-col">
    <div class="product__image">
      {%- if product.selected_or_first_available_variant.featured_image -%}
        <img
          src="{{ product.selected_or_first_available_variant.featured_image | image_url: width: 1200 }}"
          alt="{{ product.selected_or_first_available_variant.featured_image.alt | default: product.title | escape }}"
          width="1200"
          height="{{ 1200 | divided_by: product.selected_or_first_available_variant.featured_image.aspect_ratio }}"
        >
      {%- elsif product.featured_image -%}
        <img
          src="{{ product.featured_image | image_url: width: 1200 }}"
          alt="{{ product.featured_image.alt | default: product.title | escape }}"
          width="1200"
          height="{{ 1200 | divided_by: product.featured_image.aspect_ratio }}"
        >
      {%- endif -%}
    </div>
  </div>

  <div class="product__info-col">
    <p class="product__name">{{ product.title }}</p>
    <p class="product__price">{{ product.selected_or_first_available_variant.price | default: product.price | money }}</p>

    <p class="product__label">{{ 'products.product.piece_number' | t }}</p>
    <p class="product__piece">
      {{ product.metafields.custom.piece_number | default: '001' }} / {{ product.metafields.custom.total_pieces | default: settings.pieces_per_drop | default: '099' }}
    </p>

    {% form 'product', product %}
      {%- if product.has_only_default_variant == false -%}
        <p class="product__label">{{ 'products.product.size' | t }}</p>
        <div class="product__sizes">
          {%- for variant in product.variants -%}
            <button
              type="button"
              class="size-btn{% if variant == product.selected_or_first_available_variant %} is-active{% endif %}{% unless variant.available %} is-sold-out{% endunless %}"
              data-variant-id="{{ variant.id }}"
              {% unless variant.available %}disabled{% endunless %}
            >
              {{ variant.title }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

      <button type="submit" class="product__submit" {% unless product.available %}disabled{% endunless %}>
        {%- if product.available -%}
          {{ 'products.product.add_to_bag' | t }}
        {%- else -%}
          {{ 'products.product.sold_out' | t }}
        {%- endif -%}
      </button>
    {% endform %}

    <hr class="product__divider">

    <p class="product__section-title">{{ 'products.product.description' | t }}</p>
    <div class="product__description">{{ product.description }}</div>
  </div>
</div>

{% schema %}
{
  "name": "Product",
  "settings": []
}
{% endschema %}
