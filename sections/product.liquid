<div class="product" data-section-id="{{ section.id }}">
  <div class="product__image-col">
    <div class="product__image" data-product-image>
      {%- if product.selected_or_first_available_variant.featured_image -%}
        <img
          src="{{ product.selected_or_first_available_variant.featured_image | image_url: width: 1200 }}"
          alt="{{ product.selected_or_first_available_variant.featured_image.alt | default: product.title | escape }}"
          width="1200"
          height="{{ 1200 | divided_by: product.selected_or_first_available_variant.featured_image.aspect_ratio }}"
        >
      {%- elsif product.featured_image -%}
        <img
          src="{{ product.featured_image | image_url: width: 1200 }}"
          alt="{{ product.featured_image.alt | default: product.title | escape }}"
          width="1200"
          height="{{ 1200 | divided_by: product.featured_image.aspect_ratio }}"
        >
      {%- endif -%}
    </div>
  </div>

  <div class="product__info-col">
    {%- assign product_form_id = 'product-form-' | append: section.id -%}
    {% form 'product', product, id: product_form_id, class: 'product__form', data-product-form: '' %}
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'title' -%}
            <p class="product__name" {{ block.shopify_attributes }}>{{ product.title }}</p>

          {%- when 'vendor' -%}
            {%- if product.vendor != blank -%}
              <p class="product__vendor" {{ block.shopify_attributes }}>{{ product.vendor }}</p>
            {%- endif -%}

          {%- when 'price' -%}
            <p class="product__price" {{ block.shopify_attributes }}>
              <span data-price>{{ product.selected_or_first_available_variant.price | default: product.price | money }}</span>
              <s class="product__price-compare" data-compare-price {% unless product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}hidden{% endunless %}>
                {{ product.selected_or_first_available_variant.compare_at_price | money }}
              </s>
            </p>
            <p
              class="product__unit-price"
              data-unit-price
              {%- unless product.selected_or_first_available_variant.unit_price_measurement %} hidden{% endunless %}
            >
              {%- if product.selected_or_first_available_variant.unit_price_measurement -%}
                {{ product.selected_or_first_available_variant.unit_price | money }}/{% if product.selected_or_first_available_variant.unit_price_measurement.reference_value != 1 %}{{ product.selected_or_first_available_variant.unit_price_measurement.reference_value }}{% endif %}{{ product.selected_or_first_available_variant.unit_price_measurement.reference_unit }}
              {%- endif -%}
            </p>

          {%- when 'piece_number' -%}
            <p class="product__label" {{ block.shopify_attributes }}>{{ 'products.product.piece_number' | t }}</p>
            <p class="product__piece">
              {{ product.metafields.custom.piece_number | default: '001' }} / {{ product.metafields.custom.total_pieces | default: settings.pieces_per_drop | default: '099' }}
            </p>

          {%- when 'variant_picker' -%}
            {%- if product.has_only_default_variant == false -%}
              <div class="product__options" data-product-options {{ block.shopify_attributes }}>
                {%- for option in product.options_with_values -%}
                  {%- assign option_index = forloop.index0 -%}
                  <p class="product__label">{{ option.name }}</p>
                  <div class="product__sizes" data-option-index="{{ option_index }}">
                    {%- for value in option.values -%}
                      {%- liquid
                        assign option_available = false
                        for variant in product.variants
                          if variant.options[option_index] == value and variant.available
                            assign option_available = true
                          endif
                        endfor
                      -%}
                      <button
                        type="button"
                        class="size-btn{% if value == option.selected_value %} is-active{% endif %}{% unless option_available %} is-sold-out{% endunless %}"
                        data-option-value="{{ value | escape }}"
                        {% unless option_available %}disabled{% endunless %}
                      >
                        {{ value }}
                      </button>
                    {%- endfor -%}
                  </div>
                {%- endfor -%}
              </div>
            {%- endif -%}

          {%- when 'quantity_selector' -%}
            <div class="product__quantity" {{ block.shopify_attributes }}>
              <label class="product__label" for="product-quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
              <input type="number" id="product-quantity-{{ section.id }}" name="quantity" class="product__quantity-input" value="1" min="1" inputmode="numeric">
            </div>

          {%- when 'buy_buttons' -%}
            {%- if product.gift_card? -%}
              <div class="product__gift-recipient">
                <label class="product__gift-recipient-toggle">
                  <input
                    type="checkbox"
                    name="properties[__shopify_send_gift_card_to_recipient]"
                    value="true"
                    data-gift-card-recipient-toggle
                  >
                  {{ 'products.product.gift_card_recipient_toggle' | t }}
                </label>

                <div class="product__gift-recipient-fields" data-gift-card-recipient-fields hidden>
                  <label class="product__label" for="gift-card-recipient-email">{{ 'products.product.gift_card_recipient_email' | t }}</label>
                  <input
                    type="email"
                    id="gift-card-recipient-email"
                    name="properties[Recipient email]"
                    class="product__gift-recipient-input"
                    data-gift-card-recipient-field
                    data-gift-card-recipient-email
                  >

                  <label class="product__label" for="gift-card-recipient-name">{{ 'products.product.gift_card_recipient_name' | t }}</label>
                  <input
                    type="text"
                    id="gift-card-recipient-name"
                    name="properties[Recipient name]"
                    class="product__gift-recipient-input"
                    maxlength="255"
                    data-gift-card-recipient-field
                  >

                  <label class="product__label" for="gift-card-recipient-message">{{ 'products.product.gift_card_recipient_message' | t }}</label>
                  <textarea
                    id="gift-card-recipient-message"
                    name="properties[Message]"
                    class="product__gift-recipient-textarea"
                    rows="3"
                    maxlength="200"
                    data-gift-card-recipient-field
                  ></textarea>

                  <label class="product__label" for="gift-card-recipient-send-on">{{ 'products.product.gift_card_recipient_send_on' | t }}</label>
                  <input
                    type="date"
                    id="gift-card-recipient-send-on"
                    name="properties[Send on]"
                    class="product__gift-recipient-input"
                    data-gift-card-recipient-field
                  >

                  <input type="hidden" name="properties[__shopify_offset]" data-gift-card-offset>
                </div>
              </div>
            {%- endif -%}
            <button type="submit" class="product__submit" data-add-to-cart {% unless product.available %}disabled{% endunless %} {{ block.shopify_attributes }}>
              <span data-add-to-cart-text>
                {%- if product.available -%}
                  {{ 'products.product.add_to_bag' | t }}
                {%- else -%}
                  {{ 'products.product.sold_out' | t }}
                {%- endif -%}
              </span>
            </button>

          {%- when 'description' -%}
            <hr class="product__divider">
            <p class="product__section-title">{{ 'products.product.description' | t }}</p>
            <div class="product__description" {{ block.shopify_attributes }}>{{ product.description }}</div>

          {%- when 'liquid' -%}
            <div class="product__custom-liquid" {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>

          {%- when '@app' -%}
            {% render block %}

        {%- endcase -%}
      {%- endfor -%}

      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-variant-id>
    {% endform %}
  </div>
</div>

<script type="application/json" data-product-json>
  {{ product | json }}
</script>

{% schema %}
{
  "name": "Product",
  "settings": [],
  "blocks": [
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": []
    },
    {
      "type": "vendor",
      "name": "Vendor",
      "limit": 1,
      "settings": []
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": []
    },
    {
      "type": "piece_number",
      "name": "Piece number",
      "limit": 1,
      "settings": []
    },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1,
      "settings": []
    },
    {
      "type": "quantity_selector",
      "name": "Quantity selector",
      "limit": 1,
      "settings": []
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": []
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1,
      "settings": []
    },
    {
      "type": "liquid",
      "name": "Custom Liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Liquid code"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "default": {
    "blocks": [
      { "type": "title" },
      { "type": "price" },
      { "type": "piece_number" },
      { "type": "variant_picker" },
      { "type": "quantity_selector" },
      { "type": "buy_buttons" },
      { "type": "description" }
    ]
  }
}
{% endschema %}
