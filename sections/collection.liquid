<div class="section-heading">
  <h1 class="section-heading__title">{{ collection.title }}</h1>
</div>

{%- assign has_active_filters = false -%}
{%- for filter in collection.filters -%}
  {%- if filter.type != 'price_range' -%}
    {%- for value in filter.values -%}
      {%- if value.active -%}
        {%- assign has_active_filters = true -%}
      {%- endif -%}
    {%- endfor -%}
  {%- elsif filter.min_value.value or filter.max_value.value -%}
    {%- assign has_active_filters = true -%}
  {%- endif -%}
{%- endfor -%}

<div class="collection-toolbar">
  {%- if collection.filters.size > 0 -%}
    <div class="collection-filters">
      {%- for filter in collection.filters -%}
        {%- case filter.type -%}
          {%- when 'list', 'boolean' -%}
            {%- assign visible_values = 0 -%}
            {%- for value in filter.values -%}
              {%- if value.count > 0 or value.active -%}
                {%- assign visible_values = visible_values | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if visible_values > 0 -%}
              <div class="collection-filters__group">
                <p class="collection-filters__label">{{ filter.label }}</p>
                <div class="collection-filters__pills">
                  {%- for value in filter.values -%}
                    {%- if value.count > 0 or value.active -%}
                      <a
                        href="{% if value.active %}{{ value.url_to_remove }}{% else %}{{ value.url_to_add }}{% endif %}"
                        class="collection-filters__pill{% if value.active %} is-active{% endif %}"
                      >
                        {{ value.label }}{% unless filter.type == 'boolean' %} ({{ value.count }}){% endunless %}
                      </a>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            {%- endif -%}

          {%- when 'price_range' -%}
            <form class="collection-filters__price" action="{{ collection.url }}">
              <p class="collection-filters__label">{{ filter.label }}</p>
              {%- for other_filter in collection.filters -%}
                {%- if other_filter.type != 'price_range' -%}
                  {%- for value in other_filter.values -%}
                    {%- if value.active -%}
                      <input type="hidden" name="{{ value.param_name }}" value="{{ value.value }}">
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              {%- endfor -%}
              <div class="collection-filters__price-inputs">
                <input
                  type="number"
                  name="{{ filter.min_value.param_name }}"
                  value="{{ filter.min_value.value }}"
                  placeholder="0"
                  min="0"
                  step="0.01"
                >
                <span>&ndash;</span>
                <input
                  type="number"
                  name="{{ filter.max_value.param_name }}"
                  value="{{ filter.max_value.value }}"
                  placeholder="{{ filter.range_max | times: 100 | money_without_currency }}"
                  min="0"
                  step="0.01"
                >
              </div>
              <button type="submit" class="collection-filters__price-apply">{{ 'collections.general.apply' | t }}</button>
            </form>
        {%- endcase -%}
      {%- endfor -%}

      {%- if has_active_filters -%}
        <a href="{{ collection.url }}" class="collection-filters__clear">{{ 'collections.general.clear_filters' | t }}</a>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="collection-toolbar__meta">
    <p class="collection-toolbar__count">
      {{ 'collections.general.item_count' | t: count: collection.products_count }}
    </p>

    <form class="collection-sort" action="{{ collection.url }}" method="get">
      {%- for filter in collection.filters -%}
        {%- if filter.type == 'price_range' -%}
          {%- if filter.min_value.value -%}
            <input type="hidden" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value }}">
          {%- endif -%}
          {%- if filter.max_value.value -%}
            <input type="hidden" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value }}">
          {%- endif -%}
        {%- else -%}
          {%- for value in filter.values -%}
            {%- if value.active -%}
              <input type="hidden" name="{{ value.param_name }}" value="{{ value.value }}">
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      {%- endfor -%}
      <label for="collection-sort-select" class="collection-sort__label">{{ 'collections.general.sort_by' | t }}</label>
      <select name="sort_by" id="collection-sort-select" class="collection-sort__select" onchange="this.form.submit()">
        {%- for option in collection.sort_options -%}
          <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>
            {{ option.name }}
          </option>
        {%- endfor -%}
      </select>
    </form>
  </div>
</div>

{%- paginate collection.products by 24 -%}
  <div class="product-grid">
    {%- for product in collection.products -%}
      {%- render 'product-card', product: product -%}
    {%- else -%}
      <p>{{ 'collections.general.no_matches' | t }}</p>
    {%- endfor -%}
  </div>

  {% if paginate.pages > 1 %}
    <div class="pagination">
      {{ paginate | default_pagination }}
    </div>
  {% endif %}
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection",
  "settings": []
}
{% endschema %}
