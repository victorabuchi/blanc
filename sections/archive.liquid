<div class="page-banner">
  <h1 class="page-banner__title">{{ section.settings.title }}</h1>
</div>

{%- if section.settings.brand_story != blank -%}
  <div class="archive-story">
    {{ section.settings.brand_story }}
  </div>
{%- endif -%}

<div class="archive-grid">
  {%- for block in section.blocks -%}
    <a href="{{ block.settings.link | default: '#' }}" class="archive-entry" {{ block.shopify_attributes }}>
      <div class="archive-entry__image">
        {%- if block.settings.image -%}
          <img
            src="{{ block.settings.image | image_url: width: 800 }}"
            alt="{{ block.settings.name | escape }}"
            loading="lazy"
            width="800"
            height="{{ 800 | divided_by: block.settings.image.aspect_ratio }}"
          >
        {%- endif -%}
      </div>
      <p class="archive-entry__date">{{ block.settings.date }}</p>
      <p class="archive-entry__name">{{ block.settings.name }}</p>
    </a>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Archive",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "ARCHIVE"
    },
    {
      "type": "richtext",
      "id": "brand_story",
      "label": "Brand story",
      "default": "<p>A record of past collections — what's been released, and what's since sold through.</p>"
    }
  ],
  "blocks": [
    {
      "type": "entry",
      "name": "Archive entry",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date",
          "default": "15.11.24"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Entry name",
          "default": "AUTUMN COLLECTION"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "Archive",
      "blocks": [
        { "type": "entry", "settings": { "date": "15.11.24", "name": "AUTUMN COLLECTION" } },
        { "type": "entry", "settings": { "date": "15.11.24", "name": "STUDIO CAMPAIGN" } },
        { "type": "entry", "settings": { "date": "15.11.24", "name": "PARTNER COLLAB" } },
        { "type": "entry", "settings": { "date": "01.09.24", "name": "SUMMER COLLECTION" } },
        { "type": "entry", "settings": { "date": "01.09.24", "name": "SEASONAL CAMPAIGN" } },
        { "type": "entry", "settings": { "date": "01.09.24", "name": "CAPSULE EDIT" } },
        { "type": "entry", "settings": { "date": "14.06.24", "name": "SPRING COLLECTION" } },
        { "type": "entry", "settings": { "date": "14.06.24", "name": "STUDIO CAMPAIGN 02" } },
        { "type": "entry", "settings": { "date": "14.06.24", "name": "PARTNER COLLAB 02" } },
        { "type": "entry", "settings": { "date": "01.03.24", "name": "DEBUT COLLECTION" } },
        { "type": "entry", "settings": { "date": "01.03.24", "name": "FIRST COLLABORATION" } },
        { "type": "entry", "settings": { "date": "01.03.24", "name": "BRAND ORIGINS" } }
      ]
    }
  ]
}
{% endschema %}
