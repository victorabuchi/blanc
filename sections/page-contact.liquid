<div class="page-banner">
  <p class="page-banner__title">{{ page.title }}</p>
</div>

<div class="page-contact">
  {%- if page.content != blank -%}
    <div class="page-contact__intro">{{ page.content }}</div>
  {%- endif -%}

  {% form 'contact', class: 'page-contact__form' %}
    {%- if form.posted_successfully? -%}
      <p class="page-contact__success">{{ 'contact.form.success' | t }}</p>
    {%- else -%}
      {%- if form.errors -%}
        <div class="page-contact__error">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <label class="page-contact__label" for="page-contact-name">{{ 'contact.form.name' | t }}</label>
      <input type="text" id="page-contact-name" name="contact[name]" class="page-contact__input" value="{{ form.name }}" required>

      <label class="page-contact__label" for="page-contact-email">{{ 'contact.form.email' | t }}</label>
      <input type="email" id="page-contact-email" name="contact[email]" class="page-contact__input" value="{{ form.email }}" required>

      <label class="page-contact__label" for="page-contact-message">{{ 'contact.form.message' | t }}</label>
      <textarea id="page-contact-message" name="contact[body]" class="page-contact__textarea" rows="6" required>{{ form.body }}</textarea>

      <button type="submit" class="page-contact__submit">{{ 'contact.form.submit' | t }}</button>
    {%- endif -%}
  {% endform %}
</div>

{% schema %}
{
  "name": "Contact page",
  "settings": []
}
{% endschema %}
