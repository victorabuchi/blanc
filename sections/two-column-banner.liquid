<div class="two-column-banner">
  {%- for block in section.blocks -%}
    <div class="two-column-banner__col" {{ block.shopify_attributes }}>
      {%- capture col_content -%}
        {%- if block.settings.image != blank -%}
          <img
            src="{{ block.settings.image | image_url: width: 1400 }}"
            alt="{{ block.settings.image.alt | default: block.settings.label | escape }}"
            loading="lazy"
            width="1400"
            height="{{ 1400 | divided_by: block.settings.image.aspect_ratio }}"
          >
        {%- endif -%}
        {%- if block.settings.label != blank -%}
          <p class="two-column-banner__label">
            {{ block.settings.label }}
            {%- if block.settings.link != blank %} <span class="two-column-banner__arrow">&gt;</span> {{ 'general.shop' | t }}{% endif -%}
          </p>
        {%- endif -%}
      {%- endcapture -%}

      {%- if block.settings.link != blank -%}
        <a href="{{ block.settings.link }}" class="two-column-banner__media">{{ col_content }}</a>
      {%- else -%}
        <div class="two-column-banner__media">{{ col_content }}</div>
      {%- endif -%}
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Two-column banner",
  "settings": [],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "limit": 2,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Two-column banner",
      "blocks": [
        { "type": "column" },
        { "type": "column" }
      ]
    }
  ]
}
{% endschema %}
