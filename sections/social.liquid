<div class="page-banner">
  <h1 class="page-banner__title">{{ section.settings.title }}</h1>
</div>

<div class="page">
  <ul class="social-list">

    <li>
      <a href="{{ settings.social_instagram_link | default: '#' }}" class="social-row" target="_blank" rel="noopener noreferrer">
        <span class="social-row__left">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1a1a1a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <circle cx="12" cy="12" r="4"/>
            <circle cx="17.5" cy="6.5" r="0.5" fill="#1a1a1a"/>
          </svg>
          <span class="social-row__platform">Instagram</span>
        </span>
        <span class="social-row__handle">{{ section.settings.handle }}</span>
      </a>
    </li>

    <li>
      <a href="{{ settings.social_tiktok_link | default: '#' }}" class="social-row" target="_blank" rel="noopener noreferrer">
        <span class="social-row__left">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="#1a1a1a">
            <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.79 1.53V6.78a4.85 4.85 0 01-1.02-.09z"/>
          </svg>
          <span class="social-row__platform">TikTok</span>
        </span>
        <span class="social-row__handle">{{ section.settings.handle }}</span>
      </a>
    </li>

    <li>
      <a href="{{ settings.social_x_link | default: '#' }}" class="social-row" target="_blank" rel="noopener noreferrer">
        <span class="social-row__left">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="#1a1a1a">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.253 5.622L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"/>
          </svg>
          <span class="social-row__platform">X</span>
        </span>
        <span class="social-row__handle">{{ section.settings.handle }}</span>
      </a>
    </li>

    <li>
      <a href="{{ settings.social_facebook_link | default: '#' }}" class="social-row" target="_blank" rel="noopener noreferrer">
        <span class="social-row__left">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="#1a1a1a">
            <path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.99 3.66 9.13 8.44 9.88v-6.99h-2.54v-2.89h2.54V9.79c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.23.2 2.23.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.89h-2.34v6.99C18.34 21.13 22 16.99 22 12z"/>
          </svg>
          <span class="social-row__platform">Facebook</span>
        </span>
        <span class="social-row__handle">{{ section.settings.handle }}</span>
      </a>
    </li>

    <li>
      <a href="{{ settings.social_youtube_link | default: '#' }}" class="social-row" target="_blank" rel="noopener noreferrer">
        <span class="social-row__left">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="#1a1a1a">
            <path d="M22.54 6.42a2.78 2.78 0 00-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 00-1.95 1.96A29 29 0 001 12a29 29 0 00.46 5.58A2.78 2.78 0 003.41 19.6C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 001.95-1.95A29 29 0 0023 12a29 29 0 00-.46-5.58zM9.75 15.02V8.98L15.5 12l-5.75 3.02z"/>
          </svg>
          <span class="social-row__platform">YouTube</span>
        </span>
        <span class="social-row__handle">{{ section.settings.handle }}</span>
      </a>
    </li>

  </ul>
</div>

{% schema %}
{
  "name": "Social",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "SOCIAL"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Handle shown per row",
      "default": "@blanc"
    }
  ],
  "presets": [
    {
      "name": "Social"
    }
  ]
}
{% endschema %}
