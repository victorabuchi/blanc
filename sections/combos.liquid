<div class="page-banner">
  <h1 class="page-banner__title">{{ section.settings.title }}</h1>
  {%- if section.settings.subtitle != blank -%}
    <p class="page-banner__subtitle">{{ section.settings.subtitle }}</p>
  {%- endif -%}
</div>

<div class="product-grid">
  {%- for product in collections[section.settings.collection].products -%}
    {%- render 'product-card', product: product -%}
  {%- else -%}
    {%- for i in (1..8) -%}
      <div class="product-card">
        <div class="product-card__image"></div>
        <div class="product-card__info">
          <p class="product-card__name">Product title</p>
          <p class="product-card__price">&euro;0</p>
        </div>
      </div>
    {%- endfor -%}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Combos",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "COMBOS"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "COMPLETE OUTFITS, CURATED"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "Combos"
    }
  ]
}
{% endschema %}
