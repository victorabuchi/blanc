<div class="password-page">
  <div class="password-page__logo">
    <img src="{{ 'blanc-logo.png' | asset_url }}" alt="{{ shop.name }}">
  </div>

  {%- if shop.password_message != blank -%}
    <div class="password-page__message">{{ shop.password_message }}</div>
  {%- endif -%}

  {% form 'storefront_password', class: 'password-page__form' %}
    {%- if form.errors -%}
      <div class="password-page__error">{{ form.errors | default_errors }}</div>
    {%- endif -%}

    <label class="password-page__label" for="password-page-password">{{ 'general.password.password_field' | t }}</label>
    <input type="password" id="password-page-password" name="password" class="password-page__input" required>

    <button type="submit" class="password-page__submit">{{ 'general.password.enter_password' | t }}</button>
  {% endform %}
</div>

{% schema %}
{
  "name": "Password",
  "settings": []
}
{% endschema %}
