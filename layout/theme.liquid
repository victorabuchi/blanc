<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    {{ page_title }}{% if page_title != shop.name %} &mdash; {{ shop.name }}{% endif %}
  </title>
  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@300;400;500&display=swap" rel="stylesheet">

  {{ content_for_header }}

  {{ 'theme.css' | asset_url | stylesheet_tag }}
</head>
<body>

  <header class="site-header">
    <div class="site-header__inner">
      <nav class="site-header__nav">
        <a href="/collections/new">New</a>
        <a href="/collections/combos">Combos</a>
        <a href="/collections/collabs">Collabs</a>
        <a href="/collections/archive">Archive</a>
      </nav>

      <div class="site-header__logo-wrapper">
        <a href="{{ routes.root_url }}" class="site-header__logo">{{ shop.name | upcase }}</a>
      </div>

      <div class="site-header__icons">

        <a href="/search" class="site-header__icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
          stroke="#000000" stroke-width="1.5" stroke-linecap="round"
          stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <span class="site-header__icon-label">SEARCH</span>
        </a>

        <a href="/pages/support" class="site-header__icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
          stroke="#000000" stroke-width="1.5" stroke-linecap="round"
          stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3"/>
            <line x1="12" y1="17" x2="12.01" y2="17"/>
          </svg>
          <span class="site-header__icon-label">HELP</span>
        </a>

        <a href="{{ routes.account_url }}" class="site-header__icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
          stroke="#000000" stroke-width="1.5" stroke-linecap="round"
          stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
          <span class="site-header__icon-label">ACCOUNT</span>
        </a>

        <a href="{{ routes.cart_url }}" class="site-header__icon site-header__cart">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
          stroke="#000000" stroke-width="1.5" stroke-linecap="round"
          stroke-linejoin="round">
            <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
            <line x1="3" y1="6" x2="21" y2="6"/>
            <path d="M16 10a4 4 0 01-8 0"/>
          </svg>
          {% if cart.item_count > 0 %}
            <span class="cart-count">{{ cart.item_count }}</span>
          {% endif %}
          <span class="site-header__icon-label">BAG ({{ cart.item_count }})</span>
        </a>

      </div>
    </div>
  </header>

  <main class="main">
    {{ content_for_layout }}
  </main>

  <footer class="site-footer">
    <div class="site-footer__inner">
      <div class="site-footer__mailing">
        <p class="site-footer__mailing-title">Mailing List</p>
        {% form 'customer', id: 'footer-newsletter-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="site-footer__mailing-form">
            <input
              type="email"
              name="contact[email]"
              class="site-footer__mailing-input"
              placeholder="Email address"
              required
            >
            <button type="submit" class="site-footer__mailing-submit">Subscribe</button>
          </div>
        {% endform %}
      </div>

      <div class="site-footer__social">
        <a href="{{ settings.social_instagram_link | default: 'https://instagram.com/frozenholm' }}" target="_blank" rel="noopener noreferrer">Instagram</a>
        <a href="{{ settings.social_tiktok_link | default: 'https://tiktok.com/@frozenholm' }}" target="_blank" rel="noopener noreferrer">TikTok</a>
        <a href="{{ settings.social_x_link | default: 'https://x.com/frozenholm' }}" target="_blank" rel="noopener noreferrer">X</a>
      </div>
    </div>
  </footer>

  {{ 'theme.js' | asset_url | script_tag }}
</body>
</html>
