<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    {{ page_title }}{% if page_title != shop.name %} &mdash; {{ shop.name }}{% endif %}
  </title>
  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">

  {{ content_for_header }}

  {{ 'theme.css' | asset_url | stylesheet_tag }}
</head>
<body>

  <header class="site-header">
    <div class="site-header__inner">
      <nav class="site-header__nav">
        <a href="/pages/new">New</a>
        <a href="/pages/combos">Combos</a>
        {%- comment -%} Collabs temporarily hidden — remove this comment to restore {%- endcomment -%}
        {%- comment -%}<a href="/pages/collabs">Collabs</a>{%- endcomment -%}
        <a href="/pages/archive">Archive</a>
        <button type="button" class="site-header__discover" aria-controls="discover-overlay">Discover</button>
      </nav>

      <div class="site-header__mobile-icons site-header__mobile-icons--left">
        <button type="button" class="site-header__icon site-header__menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav-drawer">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
          stroke="#000000" stroke-width="1.5" stroke-linecap="round"
          stroke-linejoin="round">
            <line x1="3" y1="6" x2="21" y2="6"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </button>

        <button type="button" class="site-header__icon site-header__search-toggle" aria-label="Open search" aria-expanded="false" aria-controls="search-overlay">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
          stroke="#000000" stroke-width="2" stroke-linecap="round"
          stroke-linejoin="round">
            <circle cx="10" cy="10" r="7"/>
            <line x1="21" y1="21" x2="15" y2="15"/>
          </svg>
        </button>
      </div>

      <div class="site-header__logo-wrapper">
        <a href="{{ routes.root_url }}" class="site-header__logo">
          <img src="{{ 'frozenholm-logo.png' | asset_url }}" alt="{{ shop.name }}" class="site-header__logo-img">
        </a>
      </div>

      <div class="site-header__mobile-icons site-header__mobile-icons--right">
        <a href="{{ routes.account_url }}" class="site-header__icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
          stroke="#000000" stroke-width="1.5" stroke-linecap="round"
          stroke-linejoin="round">
            <circle cx="12" cy="7" r="3.5"/>
            <rect x="6" y="10" width="12" height="11" rx="1"/>
          </svg>
        </a>

        <a href="{{ routes.cart_url }}" class="site-header__icon site-header__cart">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
          stroke="#000000" stroke-width="1.5" stroke-linecap="round"
          stroke-linejoin="round">
            <rect x="4" y="9" width="16" height="12" rx="1"/>
            <rect x="10" y="5" width="4" height="4"/>
          </svg>
          {% if cart.item_count > 0 %}
            <span class="cart-count">{{ cart.item_count }}</span>
          {% endif %}
        </a>
      </div>

      <div class="site-header__icons">

        <button type="button" class="site-header__icon site-header__search-toggle" aria-label="Open search" aria-expanded="false" aria-controls="search-overlay">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
          stroke="#000000" stroke-width="2" stroke-linecap="round"
          stroke-linejoin="round">
            <circle cx="10" cy="10" r="7"/>
            <line x1="21" y1="21" x2="15" y2="15"/>
          </svg>
          <span class="site-header__icon-label">SEARCH</span>
        </button>

        <button type="button" class="site-header__icon help-overlay-toggle" aria-label="Open help" aria-expanded="false" aria-controls="help-overlay">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
          stroke="#000000" stroke-width="1.5" stroke-linecap="round"
          stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3"/>
            <line x1="12" y1="17" x2="12.01" y2="17"/>
          </svg>
          <span class="site-header__icon-label">HELP</span>
        </button>

        <a href="{{ routes.account_url }}" class="site-header__icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
          stroke="#000000" stroke-width="1.5" stroke-linecap="round"
          stroke-linejoin="round">
            <circle cx="12" cy="7" r="3.5"/>
            <rect x="6" y="10" width="12" height="11" rx="1"/>
          </svg>
          <span class="site-header__icon-label">ACCOUNT</span>
        </a>

        <a href="{{ routes.cart_url }}" class="site-header__icon site-header__cart">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
          stroke="#000000" stroke-width="1.5" stroke-linecap="round"
          stroke-linejoin="round">
            <rect x="4" y="9" width="16" height="12" rx="1"/>
            <rect x="10" y="5" width="4" height="4"/>
          </svg>
          {% if cart.item_count > 0 %}
            <span class="cart-count">{{ cart.item_count }}</span>
          {% endif %}
          <span class="site-header__icon-label">BAG ({{ cart.item_count }})</span>
        </a>

      </div>
    </div>
  </header>

  <div class="mobile-nav-overlay" id="mobile-nav-overlay" hidden></div>
  <nav class="mobile-nav-drawer" id="mobile-nav-drawer" aria-label="Main menu" aria-hidden="true">
    <div class="mobile-nav-drawer__header">
      <img src="{{ 'frozenholm-logo.png' | asset_url }}" alt="{{ shop.name }}" class="mobile-nav-drawer__title">
      <button type="button" class="mobile-nav-drawer__close" aria-label="Close menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
        stroke="#000000" stroke-width="1.5" stroke-linecap="round"
        stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
    <ul class="mobile-nav-drawer__links">
      <li><a href="/pages/new">New</a></li>
      <li><a href="/pages/combos">Combos</a></li>
      {%- comment -%}<li><a href="/pages/collabs">Collabs</a></li>{%- endcomment -%}
      <li><a href="/pages/archive">Archive</a></li>
      <li><button type="button" class="help-overlay-toggle" aria-controls="help-overlay">Help</button></li>
    </ul>
  </nav>

  <div class="search-overlay-backdrop" id="search-overlay-backdrop" hidden></div>
  <div class="search-overlay" id="search-overlay" aria-hidden="true">
    <div class="search-overlay__header">
      <img src="{{ 'frozenholm-logo.png' | asset_url }}" alt="{{ shop.name }}" class="search-overlay__title">
      <button type="button" class="search-overlay__close" aria-label="Close search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
        stroke="#000000" stroke-width="1.5" stroke-linecap="round"
        stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <form action="/search" method="get" role="search" class="search-overlay__form">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
      stroke="#000000" stroke-width="1.5" stroke-linecap="round"
      stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"/>
        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      <input type="search" name="q" class="search-overlay__input" placeholder="WHAT ARE YOU LOOKING FOR?" autocomplete="off">
    </form>

    <div class="search-overlay__suggestions">
      <p class="search-overlay__suggestions-title">Suggestions</p>
      <ul class="search-overlay__suggestions-list">
        <li><a href="/pages/new">New</a></li>
        <li><a href="/pages/combos">Combos</a></li>
        {%- comment -%}<li><a href="/pages/collabs">Collabs</a></li>{%- endcomment -%}
        <li><a href="/pages/archive">Archive</a></li>
        <li><button type="button" class="help-overlay-toggle" aria-controls="help-overlay">Help</button></li>
      </ul>
    </div>
  </div>

  <div class="help-overlay-backdrop" id="help-overlay-backdrop" hidden></div>
  <div class="help-overlay" id="help-overlay" aria-hidden="true">
    <div class="help-overlay__header">
      <span class="help-overlay__title">Help</span>
      <button type="button" class="help-overlay__close" aria-label="Close help">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
        stroke="#000000" stroke-width="1.5" stroke-linecap="round"
        stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <div class="help-overlay__list">
      <div class="help-overlay__item">
        <a href="#" class="help-overlay__link">Live chat <span class="help-overlay__status">Offline</span></a>
        <p class="help-overlay__detail">Monday to Saturday, 9am to 6pm EST</p>
      </div>

      <div class="help-overlay__item">
        <a href="#" class="help-overlay__link">Call <span class="help-overlay__status">Offline</span></a>
        <p class="help-overlay__detail">Monday to Saturday, 9am to 6pm EST</p>
      </div>

      <div class="help-overlay__item">
        <a href="mailto:hello@frozenholm.com" class="help-overlay__link">Email</a>
        <p class="help-overlay__detail">hello@frozenholm.com</p>
      </div>
    </div>

    <div class="help-overlay__list">
      <a href="{{ routes.account_url }}" class="help-overlay__plain-link">Order status</a>
      <a href="/pages/support" class="help-overlay__plain-link">Register a return</a>
      <a href="/pages/support" class="help-overlay__plain-link">FAQs</a>
    </div>
  </div>

  <div class="discover-overlay-backdrop" id="discover-overlay-backdrop" hidden></div>
  <div class="discover-overlay" id="discover-overlay" aria-hidden="true">
    <div class="discover-overlay__header">
      <button type="button" class="discover-overlay__close" aria-label="Close discover">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
        stroke="#000000" stroke-width="1.5" stroke-linecap="round"
        stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <div class="discover-overlay__links">
      <a href="/pages/new" class="discover-overlay__link">New</a>
      <a href="/pages/combos" class="discover-overlay__link">Combos</a>
      <a href="/pages/archive" class="discover-overlay__link">Archive</a>
    </div>

    <div class="discover-overlay__utility">
      <a href="{{ routes.account_url }}" class="discover-overlay__utility-link">Login</a>
      <button type="button" class="discover-overlay__utility-link location-overlay-toggle" aria-controls="location-overlay">
        Country/Region: {{ localization.country.name | default: 'Finland' }}
      </button>
      <button type="button" class="discover-overlay__utility-link location-overlay-toggle" aria-controls="location-overlay">
        Language: {{ localization.language.endonym_name | default: 'English' }}
      </button>
      <button type="button" class="discover-overlay__utility-link help-overlay-toggle" aria-controls="help-overlay">Client services</button>
    </div>
  </div>

  <main class="main">
    {{ content_for_layout }}
  </main>

  <footer class="site-footer">
    <div class="site-footer__promo">
      <div class="site-footer__mailing">
        <p class="site-footer__mailing-title">Newsletter</p>
        <p class="site-footer__mailing-subtitle">Receive news about Frozenholm drops, collabs and sales.</p>
        {% form 'customer', id: 'footer-newsletter-form', class: 'site-footer__mailing-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="site-footer__mailing-field">
            <input
              type="email"
              id="footer-newsletter-email"
              name="contact[email]"
              class="site-footer__mailing-input"
              placeholder=" "
              required
            >
            <div class="site-footer__mailing-row">
              <label for="footer-newsletter-email" class="site-footer__mailing-label">Email</label>
              <button type="submit" class="site-footer__mailing-submit">Sign up</button>
            </div>
          </div>
        {% endform %}
      </div>

      <div class="site-footer__promo-item">
        <p class="site-footer__promo-title">Free shipping &amp; returns</p>
        <p class="site-footer__promo-text">Fast delivery and easy returns on all orders.</p>
      </div>

      <div class="site-footer__promo-item">
        <p class="site-footer__promo-title">Secure checkout</p>
        <p class="site-footer__promo-text">Encrypted payments through Shopify's secure checkout.</p>
      </div>
    </div>

    <div class="site-footer__links">
      <div class="site-footer__links-col">
        <p class="site-footer__links-title">Contact us</p>
        <a href="#" class="site-footer__links-link">Live chat<span class="site-footer__links-status">Offline</span></a>
        <a href="#" class="site-footer__links-link">Call<span class="site-footer__links-status">Offline</span></a>
        <a href="mailto:hello@frozenholm.com" class="site-footer__links-link">Email</a>
      </div>

      <div class="site-footer__links-col">
        <p class="site-footer__links-title">Help</p>
        <a href="{{ routes.account_url }}" class="site-footer__links-link">Order status</a>
        <a href="/pages/support" class="site-footer__links-link">Register a return</a>
        <a href="/pages/support" class="site-footer__links-link">FAQs</a>
      </div>

      <div class="site-footer__links-col">
        <p class="site-footer__links-title">Shop</p>
        <a href="/pages/new" class="site-footer__links-link">New</a>
        <a href="/pages/combos" class="site-footer__links-link">Combos</a>
        <a href="/pages/archive" class="site-footer__links-link">Archive</a>
      </div>

      <div class="site-footer__links-col">
        <p class="site-footer__links-title">Company</p>
        <a href="/pages/archive" class="site-footer__links-link">About</a>
        <a href="/pages/social" class="site-footer__links-link">Social</a>
        {%- if shop.privacy_policy -%}
          <a href="{{ shop.privacy_policy.url }}" class="site-footer__links-link">Privacy policy</a>
        {%- endif -%}
        {%- if shop.terms_of_service -%}
          <a href="{{ shop.terms_of_service.url }}" class="site-footer__links-link">Terms of service</a>
        {%- endif -%}
      </div>
    </div>

    <div class="site-footer__bottom">
      <div class="site-footer__bottom-row">
        <span class="site-footer__copyright">&copy; 2026 {{ shop.name | upcase }}</span>

        <div class="site-footer__social">
          <a href="{{ settings.social_instagram_link | default: 'https://instagram.com/frozenholm' }}" target="_blank" rel="noopener noreferrer">Instagram</a>
          <a href="{{ settings.social_tiktok_link | default: 'https://tiktok.com/@frozenholm' }}" target="_blank" rel="noopener noreferrer">TikTok</a>
          <a href="{{ settings.social_x_link | default: 'https://x.com/frozenholm' }}" target="_blank" rel="noopener noreferrer">X</a>
          <a href="{{ settings.social_facebook_link | default: 'https://facebook.com/frozenholm' }}" target="_blank" rel="noopener noreferrer">Facebook</a>
        </div>

        <button type="button" class="site-footer__location-toggle" aria-controls="location-overlay">
          Shipping to {{ localization.country.name | default: 'Finland' | upcase }} ({{ localization.language.endonym_name | default: 'English' | upcase }})
        </button>
      </div>

      <div class="site-footer__bottom-row">
        <button type="button" class="site-footer__cookie-toggle" aria-controls="cookie-overlay">Cookie settings</button>
      </div>
    </div>
  </footer>

  <div class="cookie-overlay-backdrop" id="cookie-overlay-backdrop" hidden></div>
  <div class="cookie-overlay" id="cookie-overlay" aria-hidden="true">
    <div class="cookie-overlay__header">
      <span class="cookie-overlay__title">Your cookie settings</span>
      <button type="button" class="cookie-overlay__close" aria-label="Close cookie settings">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
        stroke="#000000" stroke-width="1.5" stroke-linecap="round"
        stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <div class="cookie-overlay__body">
      <h2 class="cookie-overlay__heading">Cookie settings</h2>
      <p class="cookie-overlay__text">
        When you visit any website, it may store or retrieve information on your browser, mostly in the form of cookies.
        This information might be about you, your preferences or your device and is mostly used to make the site work
        as you expect it to. Because we respect your right to privacy, you can choose not to allow some types of
        cookies. Blocking some types of cookies may impact your experience of the site and the services we are able
        to offer.
      </p>

      <h2 class="cookie-overlay__heading">Manage consent preferences</h2>

      <div class="cookie-overlay__row">
        <span class="cookie-overlay__row-label">Performance cookies</span>
        <label class="cookie-overlay__switch">
          <input type="checkbox" data-cookie-toggle="analytics" checked>
          <span class="cookie-overlay__switch-track"></span>
        </label>
      </div>

      <div class="cookie-overlay__row">
        <span class="cookie-overlay__row-label">Targeting cookies</span>
        <label class="cookie-overlay__switch">
          <input type="checkbox" data-cookie-toggle="marketing" checked>
          <span class="cookie-overlay__switch-track"></span>
        </label>
      </div>

      <div class="cookie-overlay__row">
        <span class="cookie-overlay__row-label">Strictly necessary cookies</span>
        <span class="cookie-overlay__row-static">Always active</span>
      </div>

      <div class="cookie-overlay__row">
        <span class="cookie-overlay__row-label">Functional cookies</span>
        <label class="cookie-overlay__switch">
          <input type="checkbox" data-cookie-toggle="preferences" checked>
          <span class="cookie-overlay__switch-track"></span>
        </label>
      </div>

      <button type="button" class="cookie-overlay__confirm">Confirm my choices</button>
    </div>
  </div>

  <div class="location-overlay-backdrop" id="location-overlay-backdrop" hidden></div>
  <div class="location-overlay" id="location-overlay" aria-hidden="true">
    <div class="location-overlay__header">
      <span class="location-overlay__title">Change location</span>
      <button type="button" class="location-overlay__close" aria-label="Close change location">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
        stroke="#000000" stroke-width="1.5" stroke-linecap="round"
        stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <div class="location-overlay__body">
      <p class="location-overlay__text">
        You are currently shipping to {{ localization.country.name | default: 'Finland' }} and your order will be
        billed in {{ localization.country.currency.iso_code | default: 'EUR' }}.
      </p>

      {%- if localization.available_countries.size > 1 -%}
        <p class="location-overlay__label">Shipping location</p>
        <input type="search" class="location-overlay__search" id="location-search" placeholder="Search locations" autocomplete="off">

        {% form 'localization', id: 'footer-country-form' %}
          <div class="location-overlay__list" id="location-country-list">
            {%- for country in localization.available_countries -%}
              <button
                type="submit"
                name="country_code"
                value="{{ country.iso_code }}"
                class="location-overlay__item{% if country.iso_code == localization.country.iso_code %} is-active{% endif %}"
                data-country-name="{{ country.name | escape }}"
              >
                {{ country.name }} ({{ country.currency.iso_code }})
              </button>
            {%- endfor -%}
          </div>
        {% endform %}
      {%- endif -%}
    </div>
  </div>

  {{ 'theme.js' | asset_url | script_tag }}
</body>
</html>
